<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 底层浅灰背景 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFF8F9FA" />
        </shape>
    </item>
    <!-- 顶部渐变装饰区 -->
    <item android:height="280dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#FF0D7377"
                android:centerColor="#FF14919B"
                android:endColor="#00F8F9FA"
                android:centerY="0.6" />
        </shape>
    </item>
</layer-list>